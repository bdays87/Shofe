# Appwrite — shared by web, mobile, and the schema sync script
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=shofe

# Server-only — used by infra/appwrite/sync.ts and the createProfile function.
# NEVER expose to the client. Do not prefix with NUXT_PUBLIC_ or VITE_.
APPWRITE_API_KEY=

# Dev Key — optional, dev-only. Bypasses platform allowlist, rate limits, and
# session limits so web/mobile clients can hit Appwrite from localhost without
# first registering a Web Platform. NEVER ship to production.
APPWRITE_DEV_KEY=

# Nuxt public runtime config (mirrors the values above for the browser)
NUXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NUXT_PUBLIC_APPWRITE_PROJECT_ID=
NUXT_PUBLIC_APPWRITE_DATABASE_ID=shofe

# Vite (Ionic mobile app)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=shofe
